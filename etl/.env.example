# Copy to `etl/.env` and fill in. That file is gitignored; this template is not.
#
#   cp etl/.env.example etl/.env
#
# Read by glaze_etl.core.config.Settings. Names are set per field rather than by a shared
# prefix: everything Supabase owns is SUPABASE_*, the pipeline's own knobs are unprefixed.

# ----------------------------------------------------------------------------- Supabase
# Settings > API > Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Settings > API > service_role.
#
# Bypasses row-level security completely. Treat it like a database password: never commit
# it, never paste it into a chat or an issue, and never ship it to the app. The app uses
# the anon key instead — see .env.local at the repo root.
SUPABASE_SERVICE_KEY=

# Settings > Database > Connection string > URI. Contains the database password. Prefer the
# pooled (pgbouncer, port 6543) URI: the crawl opens a connection per product.
SUPABASE_DB_URL=

# Private bucket for cached product photographs. Created automatically if absent, always
# private — reads go through short-lived signed URLs. A public bucket would make this a
# rehost of the manufacturer's photography rather than a cache.
SUPABASE_STORAGE_BUCKET=product-images

# ----------------------------------------------------------------------------- Temporal
# 127.0.0.1 rather than localhost is deliberate: Docker may also hold *:7233 on IPv6, and
# resolving through localhost can reach the wrong process.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# ----------------------------------------------------------------------------- pipeline
# Snapshots kept per URL. Source pages are ~75KB and a full pass is ~350 of them, so this
# bounds raw_snapshots growth across weekly crawls.
SNAPSHOT_RETENTION=3

REQUEST_TIMEOUT_S=45
MAX_ATTEMPTS=4

# Only used when no Supabase credentials are set, in which case images cache here instead.
BLOB_DIR=./.blobs
