# Copy to `etl/.env` and fill in. That file is gitignored; this template is not.
#
#   cp etl/.env.example etl/.env
#
# Read by glaze_etl.core.config.Settings (pydantic-settings, GLAZE_ETL_ prefix). The ETL
# writes to the database and to Storage, so it runs as the service role — never as anon.

# ---------------------------------------------------------------------- Supabase project
# Project URL, e.g. https://abcdefghijklm.supabase.co
GLAZE_ETL_SUPABASE_URL=

# SERVICE ROLE key — Settings ▸ API ▸ service_role.
#
# This bypasses row-level security completely. Treat it like a database password: never
# commit it, never paste it into a chat or an issue, and never ship it to the app. The app
# uses the anon key instead (see .env.local at the repo root).
GLAZE_ETL_SUPABASE_SERVICE_KEY=

# Private Storage bucket for cached glaze photographs. Created automatically if absent,
# always private — reads go through short-lived signed URLs. A public bucket would make
# this a plain rehost of AMACO's photography rather than a cache.
GLAZE_ETL_STORAGE_BUCKET=glaze-images

# ------------------------------------------------------------------------------- Postgres
# Settings ▸ Database ▸ Connection string ▸ URI. Contains the database password.
# Prefer the pooled (pgbouncer, port 6543) URI for the ETL — the crawl opens and closes a
# connection per product.
GLAZE_ETL_DATABASE_URL=

# ------------------------------------------------------------------------------- Temporal
# Local dev server by default. 127.0.0.1 rather than localhost is deliberate: Docker may
# also hold *:7233 on IPv6, and resolving through localhost can reach the wrong process.
GLAZE_ETL_TEMPORAL_ADDRESS=127.0.0.1:7233
GLAZE_ETL_TEMPORAL_NAMESPACE=default

# --------------------------------------------------------------------------------- tuning
# Snapshots kept per URL. AMACO pages are ~75KB and a full pass is ~350 of them, so this
# bounds raw_snapshots growth across weekly crawls.
GLAZE_ETL_SNAPSHOT_RETENTION=3

# Only used when no Supabase credentials are set, in which case images cache here instead.
GLAZE_ETL_BLOB_DIR=./.blobs
