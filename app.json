{
  "expo": {
    "name": "mudbud",
    "slug": "mudbud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mudbud",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mudbud.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mudbud uses your photo library so you can add photos and videos of your pieces.",
          "cameraPermission": "Mudbud uses the camera so you can capture your pottery process.",
          "microphonePermission": "Mudbud uses the microphone when you record video of your process."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mudbud uses the camera so you can capture your pottery process.",
          "microphonePermission": "Mudbud uses the microphone when you record video of your process."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "93c1df0f-b7c4-42ed-9664-01c9a5774aa1"
      }
    },
    "owner": "nickscip"
  }
}
