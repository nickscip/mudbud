# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
#
# Every .env is ignored, not just *.local. The ETL reads `etl/.env` (pydantic-settings
# env_file) and that file holds the Supabase service-role key, which bypasses RLS
# entirely. Only the .example templates are tracked.
.env
.env.*
# Templates are tracked. The glob must reach .env.local.example too, not just .env.example.
!.env*.example
!*/.env*.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# python etl
etl/.venv/
etl/.pytest_cache/
etl/.mypy_cache/
etl/.ruff_cache/
__pycache__/
*.py[cod]
etl/.blobs/
