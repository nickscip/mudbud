# Copy to `.env.local` (gitignored) and fill in. Read by Expo at bundle time — only
# EXPO_PUBLIC_* variables are inlined into the app.

# Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Settings > API > publishable key (`sb_publishable_...`).
#
# This is what Supabase used to call the "anon" key. It is meant to ship inside the client
# bundle: it grants only what the row-level security policies allow, which for this project is
# SELECT on the catalog tables. Never put the *secret* key here — that one bypasses RLS and
# belongs only in etl/.env.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
